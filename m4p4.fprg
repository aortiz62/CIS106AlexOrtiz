<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="m4p4"/>
        <attribute name="authors" value="mekam"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-14 03:12:02 AM"/>
        <attribute name="created" value="bWVrYW07R1JFRU5URUE7MjAyNi0wOS0xNDswMzowMTo0MiBBTTsyMzcz"/>
        <attribute name="edited" value="bWVrYW07R1JFRU5URUE7MjAyNi0wOS0xNDswMzoxMjowMiBBTTsxOzI0Nzk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="firstname" type="String" array="False" size=""/>
            <declare name="stepswalked" type="Integer" array="False" size=""/>
            <declare name="caloriesburned" type="Real" array="False" size=""/>
            <output expression="&quot;enter your first name&quot;" newline="True"/>
            <input variable="firstname"/>
            <output expression="&quot;enter steps walked&quot;" newline="True"/>
            <input variable="stepswalked"/>
            <assign variable="caloriesburned" expression="stepswalked * .25"/>
            <output expression="firstname&amp; &quot;the amount of calories you burned today is&quot; &amp;caloriesburned" newline="True"/>
        </body>
    </function>
</flowgorithm>
