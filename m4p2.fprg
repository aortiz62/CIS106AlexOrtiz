<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="m4p2"/>
        <attribute name="authors" value="mekam"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-14 01:41:57 AM"/>
        <attribute name="created" value="bWVrYW07R1JFRU5URUE7MjAyNi0wOS0xNDswMToxODoyMSBBTTsyMzc2"/>
        <attribute name="edited" value="bWVrYW07R1JFRU5URUE7MjAyNi0wOS0xNDswMTo0MTo1NyBBTTsxOzI0ODk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="purchaseprice" type="Real" array="False" size=""/>
            <declare name="currentprice" type="Real" array="False" size=""/>
            <declare name="value" type="Real" array="False" size=""/>
            <declare name="quantity" type="Integer" array="False" size=""/>
            <output expression="&quot;enter the purchase price per share&quot;" newline="True"/>
            <input variable="purchaseprice"/>
            <output expression="&quot;enter the current stock price&quot;" newline="True"/>
            <input variable="currentprice"/>
            <output expression="&quot;enter the quantity of the shares&quot;" newline="True"/>
            <input variable="quantity"/>
            <assign variable="value" expression="currentprice - purchaseprice * quantity"/>
            <if expression="value &gt;=0">
                <then>
                    <output expression="&quot;you are earning more money&quot; &amp;value" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;you are losing money&quot; &amp;value" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
