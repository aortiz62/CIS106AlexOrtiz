<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="m7p5"/>
        <attribute name="authors" value="mekam"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-03 03:02:34 AM"/>
        <attribute name="created" value="bWVrYW07R1JFRU5URUE7MjAyNi0xMC0wMzswMjo0OTo0MSBBTTsyMzcz"/>
        <attribute name="edited" value="bWVrYW07R1JFRU5URUE7MjAyNi0xMC0wMzswMzowMjozNCBBTTsxOzI0NzM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="continuechoice" type="String" array="False" size=""/>
            <declare name="quantity" type="Integer" array="False" size=""/>
            <declare name="price" type="Real" array="False" size=""/>
            <declare name="extprice" type="Real" array="False" size=""/>
            <declare name="discountamt" type="Real" array="False" size=""/>
            <declare name="total" type="Real" array="False" size=""/>
            <declare name="sumdiscount" type="Real" array="False" size=""/>
            <output expression="&quot;do you want to run this program? type yes to continue&quot;" newline="True"/>
            <input variable="continuechoice"/>
            <while expression="continuechoice == &quot;yes&quot;">
                <output expression="&quot;what is the quantity and price?&quot;" newline="True"/>
                <input variable="quantity"/>
                <input variable="price"/>
                <assign variable="extprice" expression="quanitity * price"/>
                <if expression="extprice &gt; 10000.00">
                    <then>
                        <assign variable="discountamt" expression="extprice * 0.25"/>
                    </then>
                    <else>
                        <assign variable="discountamt" expression="extprice * 0.10"/>
                    </else>
                </if>
                <assign variable="total" expression="extprice - discountamt"/>
                <assign variable="sumdiscount" expression="sumdiscount + discountamt"/>
                <output expression="&quot;&amp;extprice , &amp;discountamt , &amp;total&quot;" newline="True"/>
                <output expression="&quot;do you want to do the loop agian? type yes to continue&quot;" newline="True"/>
                <input variable="continuechoice"/>
                <output expression="&quot;&amp;sumdiscount&quot;" newline="True"/>
            </while>
        </body>
    </function>
</flowgorithm>
