    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="exam1" type="Real" array="False" size=""/>
            <declare name="exam2" type="Real" array="False" size=""/>
            <declare name="totalscore" type="Real" array="False" size=""/>
            <output expression="&quot;enter the first exam score&quot;" newline="True"/>
            <input variable="exam1"/>
            <output expression="&quot;enter the second exam score&quot;" newline="True"/>
            <input variable="exam2"/>
            <assign variable="totalscore" expression="exam1 * .60 + exam2 * .40"/>
            <output expression="&quot;your totalscore is&quot; &amp;totalscore" newline="True"/>
        </body>
    </function>
</flowgorithm>
