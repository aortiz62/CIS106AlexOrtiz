<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="m5p1"/>
        <attribute name="authors" value="mekam"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-18 03:39:56 PM"/>
        <attribute name="created" value="bWVrYW07R1JFRU5URUE7MjAyNi0wOS0xODswMjo1OTo0OSBQTTsyNDEx"/>
        <attribute name="edited" value="bWVrYW07R1JFRU5URUE7MjAyNi0wOS0xODswMzozOTo1NiBQTTsxOzI1MTY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="quantity" type="Integer" array="False" size=""/>
            <declare name="unitprice" type="Real" array="False" size=""/>
            <declare name="extendedprice" type="Real" array="False" size=""/>
            <declare name="tax" type="Real" array="False" size=""/>
            <declare name="total" type="Real" array="False" size=""/>
            <output expression="&quot;enter the quantity of items&quot;" newline="True"/>
            <input variable="quantity"/>
            <if expression="quantity &gt;= 1000">
                <then>
                    <assign variable="unitprice" expression="3.00"/>
                </then>
                <else>
                    <assign variable="unitprice" expression="5.00"/>
                </else>
            </if>
            <assign variable="extendedprice" expression="quantity * unitprice"/>
            <assign variable="tax" expression="extendedprice * 0.7"/>
            <assign variable="total" expression="extendedprice + tax"/>
            <output expression="&quot;quantity: &quot; &amp; quantity" newline="True"/>
            <output expression="&quot;Unit Price: $&quot; &amp; unitPrice" newline="True"/>
            <output expression="&quot;Extended Price: $&quot; &amp; extendedPrice" newline="True"/>
            <output expression="&quot;Tax (7%): $&quot; &amp; tax" newline="True"/>
            <output expression="&quot;Total Price: $&quot; &amp; total" newline="True"/>
        </body>
    </function>
</flowgorithm>
