<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="m9p1"/>
        <attribute name="authors" value="mekam"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-20 04:50:03 PM"/>
        <attribute name="created" value="bWVrYW07R1JFRU5URUE7MjAyNi0xMC0yMDswNDozMTo1OCBQTTsyMzg4"/>
        <attribute name="edited" value="bWVrYW07R1JFRU5URUE7MjAyNi0xMC0yMDswNDo1MDowMyBQTTsxOzI0ODc="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="qty" type="Real" array="False" size=""/>
            <declare name="price" type="Real" array="False" size=""/>
            <declare name="itemtotal" type="Real" array="False" size=""/>
            <declare name="extendedtotal" type="Real" array="False" size=""/>
            <assign variable="extendedtotal" expression="0"/>
            <output expression="&quot;enter quantity&quot;" newline="True"/>
            <input variable="qty"/>
            <while expression="qty !=0">
                <input variable="price"/>
                <assign variable="itemtotal" expression="ComputeTotal(qty, price)"/>
                <assign variable="extendedprice" expression="extendedTotal + itemTotal"/>
                <output expression="qty" newline="True"/>
                <output expression="price" newline="True"/>
                <output expression="itemtotal" newline="True"/>
                <input variable="qty"/>
            </while>
            <output expression="extendedtotal" newline="True"/>
        </body>
    </function>
</flowgorithm>
