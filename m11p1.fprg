<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="m11p1"/>
        <attribute name="authors" value="mekam"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-03 03:33:44 PM"/>
        <attribute name="created" value="bWVrYW07R1JFRU5URUE7MjAyNi0xMS0wMzswMzoyMDozMCBQTTsyMzc3"/>
        <attribute name="edited" value="bWVrYW07R1JFRU5URUE7MjAyNi0xMS0wMzswMzozMzo0NCBQTTsxOzI0OTQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="qty" type="Real" array="False" size=""/>
            <declare name="price" type="Real" array="False" size=""/>
            <declare name="rate" type="Real" array="False" size=""/>
            <declare name="discamount" type="Real" array="False" size=""/>
            <declare name="discprice" type="Real" array="False" size=""/>
            <declare name="totalcost" type="Real" array="False" size=""/>
            <output expression="&quot;enter quantity&quot;" newline="True"/>
            <input variable="qty"/>
            <output expression="&quot;enter unit price&quot;" newline="True"/>
            <input variable="price"/>
            <output expression="&quot;enter discount rate&quot;" newline="True"/>
            <input variable="rate"/>
            <assign variable="totalcost" expression="qty * price"/>
            <assign variable="discamount" expression="getdiscountamount(qty, price, rate)"/>
            <assign variable="discprice" expression="totalcost - discamount"/>
            <output expression="&quot;quantity:&quot; &amp;qty" newline="True"/>
            <output expression="&quot;unit price:&quot; &amp;price" newline="True"/>
            <output expression="&quot;discount amount:&quot; &amp;discamount" newline="True"/>
            <output expression="&quot;discount price:&quot; &amp;discprice" newline="True"/>
        </body>
    </function>
    <function name="getdiscountamount" type="Real" variable="discountamount">
        <parameters>
            <parameter name="qty" type="Integer" array="False"/>
            <parameter name="price" type="Real" array="False"/>
            <parameter name="rate" type="Real" array="False"/>
        </parameters>
        <body>
            <declare name="discountamount" type="Real" array="False" size=""/>
            <assign variable="discountamount" expression="(qty * price) * (rate / 100)"/>
        </body>
    </function>
</flowgorithm>
