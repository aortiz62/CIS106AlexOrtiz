<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="m5p5"/>
        <attribute name="authors" value="mekam"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-18 04:48:46 PM"/>
        <attribute name="created" value="bWVrYW07R1JFRU5URUE7MjAyNi0wOS0xODswNDozODo1NCBQTTsyNDA2"/>
        <attribute name="edited" value="bWVrYW07R1JFRU5URUE7MjAyNi0wOS0xODswNDo0ODo0NiBQTTsxOzI1MTY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="lastname" type="String" array="False" size=""/>
            <declare name="dependents" type="Integer" array="False" size=""/>
            <declare name="grossincome" type="Real" array="False" size=""/>
            <declare name="adjgrossincome" type="Real" array="False" size=""/>
            <declare name="incometax" type="Real" array="False" size=""/>
            <output expression="&quot;enter your last name&quot;" newline="True"/>
            <input variable="lastname"/>
            <output expression="&quot;enter your gross income&quot;" newline="True"/>
            <input variable="grossincome"/>
            <output expression="&quot;enter the amount of dependents&quot;" newline="True"/>
            <input variable="dependents"/>
            <assign variable="adjgrossincome" expression="grossincome - (dependents * 12000)"/>
            <if expression="adjgrossincome &gt; 50000">
                <then>
                    <assign variable="incometax" expression="adjgrossincome * 0.20"/>
                </then>
                <else>
                    <assign variable="incometax" expression="adjgrossincome * 0.10"/>
                </else>
            </if>
            <if expression="incometax &lt; 0">
                <then>
                    <assign variable="incometax" expression="100"/>
                </then>
                <else/>
            </if>
            <output expression="&quot;last name:&quot; &amp; lastname" newline="True"/>
            <output expression="&quot;gross income:&quot; &amp;grossincome" newline="True"/>
            <output expression="&quot;number of dependents:&quot; &amp;dependents" newline="True"/>
            <output expression="&quot;adjusted gross income:&quot; &amp;adjgrossincome" newline="True"/>
            <output expression="&quot;income tax:&quot; &amp;incometax" newline="True"/>
        </body>
    </function>
</flowgorithm>
