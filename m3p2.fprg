    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="lastname" type="String" array="False" size=""/>
            <declare name="midtermscore" type="Integer" array="False" size=""/>
            <declare name="finalexamscore" type="Integer" array="False" size=""/>
            <declare name="totalscore" type="Real" array="False" size=""/>
            <input variable="lastname"/>
            <input variable="midtermscore"/>
            <input variable="finalexamscore"/>
            <assign variable="totalscore" expression="midtermscore * finalexamscore"/>
            <output expression="&quot;your total score is&quot; &amp;totalscore" newline="True"/>
        </body>
    </function>
</flowgorithm>
