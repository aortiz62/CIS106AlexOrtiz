    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="totalamount" type="Real" array="False" size=""/>
            <declare name="numberofpeople" type="Integer" array="False" size=""/>
            <declare name="amountshared" type="Integer" array="False" size=""/>
            <input variable="totalamount"/>
            <input variable="numberofpeople"/>
            <assign variable="amountshared" expression="totalamount / numberofpeople"/>
            <output expression="&quot;the amount each person recieves is&quot; &amp;amountshared" newline="True"/>
        </body>
    </function>
</flowgorithm>
