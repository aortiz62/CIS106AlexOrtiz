<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="m9p3"/>
        <attribute name="authors" value="mekam"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-20 05:05:22 PM"/>
        <attribute name="created" value="bWVrYW07R1JFRU5URUE7MjAyNi0xMC0yMDswNDo1NjowNSBQTTsyMzg3"/>
        <attribute name="edited" value="bWVrYW07R1JFRU5URUE7MjAyNi0xMC0yMDswNTowNToyMiBQTTsxOzI0ODk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="city" type="String" array="False" size=""/>
            <declare name="miles" type="Real" array="False" size=""/>
            <declare name="gallons" type="Real" array="False" size=""/>
            <declare name="mpg" type="Real" array="False" size=""/>
            <declare name="tripcount" type="Integer" array="False" size=""/>
            <assign variable="tripcount" expression="0"/>
            <input variable="city"/>
            <while expression="city !=&quot;exit&quot;">
                <input variable="miles"/>
                <input variable="gallons"/>
                <assign variable="mpg" expression="ComputeMPG(miles, gallons)"/>
                <assign variable="tripcount" expression="tripCount + 1"/>
                <output expression="city" newline="True"/>
                <output expression="miles" newline="True"/>
                <output expression="mpg" newline="True"/>
                <input variable="city"/>
            </while>
            <output expression="tripcount" newline="True"/>
        </body>
    </function>
</flowgorithm>
