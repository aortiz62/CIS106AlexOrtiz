<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="m8p4"/>
        <attribute name="authors" value="mekam"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-10 04:22:12 PM"/>
        <attribute name="created" value="bWVrYW07R1JFRU5URUE7MjAyNi0xMC0xMDswNDowNzoyNyBQTTsyMzg2"/>
        <attribute name="edited" value="bWVrYW07R1JFRU5URUE7MjAyNi0xMC0xMDswNDoyMjoxMiBQTTsyOzI0ODY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="item" type="String" array="False" size=""/>
            <declare name="quantity" type="Integer" array="False" size=""/>
            <declare name="ordercount" type="Integer" array="False" size=""/>
            <declare name="price" type="Real" array="False" size=""/>
            <declare name="extendedprice" type="Real" array="False" size=""/>
            <declare name="totalextendedprice" type="Real" array="False" size=""/>
            <declare name="averageorder" type="Real" array="False" size=""/>
            <assign variable="totalextendedprice" expression="0"/>
            <assign variable="ordercount" expression="0"/>
            <open expression="&quot;orders.txt&quot;" mode="read"/>
            <read variable="item"/>
            <while expression="NOT EOF(myfile)">
                <read variable="quantity"/>
                <read variable="price"/>
                <assign variable="extendedprice" expression="quantity * price"/>
                <assign variable="totalextendedprice" expression="totalextendedprice + extendedprice"/>
                <assign variable="ordercount" expression="ordercount + 1"/>
                <output expression="item &amp; &quot; | Qty: &quot; &amp; quantity &amp; &quot; | Price: $&quot; &amp; price &amp; &quot; | Extended: $&quot; &amp; extendedPrice" newline="True"/>
                <read variable="item"/>
            </while>
            <assign variable="averageorder" expression="totalextendedprice / ordercount"/>
            <output expression="&quot;Total Sales: $&quot; &amp; totalExtendedPrice &amp; &quot; | Total Orders: &quot; &amp; orderCount &amp; &quot; | Average Order: $&quot; &amp; averageOrder" newline="True"/>
            <close mode="read"/>
        </body>
    </function>
</flowgorithm>
