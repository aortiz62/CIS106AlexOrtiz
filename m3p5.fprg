<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="m3p5"/>
        <attribute name="authors" value="mekam"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-09 12:45:49 AM"/>
        <attribute name="created" value="bWVrYW07R1JFRU5URUE7MjAyNi0wOS0wOTsxMjowNzoyNyBBTTsyMzg2"/>
        <attribute name="edited" value="bWVrYW07R1JFRU5URUE7MjAyNi0wOS0wOTsxMjo0NTo0OSBBTTsxOzI1MDA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="radiusofcircle" type="Real" array="False" size=""/>
            <declare name="area" type="Real" array="False" size=""/>
            <declare name="perimeter" type="Real" array="False" size=""/>
            <declare name="radius" type="Integer" array="False" size=""/>
            <input variable="radiusofcircle"/>
            <input variable="radius"/>
            <assign variable="area" expression="3.14 * radius * radius"/>
            <assign variable="perimeter" expression="2 * 3.14 * radius"/>
            <output expression="&quot;area of the circle is&quot; &amp;area" newline="True"/>
            <output expression="&quot;the perimeter of the circle is&quot; &amp;perimeter" newline="True"/>
        </body>
    </function>
</flowgorithm>
