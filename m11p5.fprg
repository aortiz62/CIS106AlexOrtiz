<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="m11p5"/>
        <attribute name="authors" value="mekam"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-03 04:40:51 PM"/>
        <attribute name="created" value="bWVrYW07R1JFRU5URUE7MjAyNi0xMS0wMzswNDoyNzozMyBQTTsyMzg4"/>
        <attribute name="edited" value="bWVrYW07R1JFRU5URUE7MjAyNi0xMS0wMzswNDo0MDo1MSBQTTsxOzI0OTE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="total" type="Real" array="False" size=""/>
            <declare name="tax" type="Real" array="False" size=""/>
            <declare name="qty" type="Integer" array="False" size=""/>
            <declare name="price" type="Real" array="False" size=""/>
            <output expression="&quot;enter quantity&quot;" newline="True"/>
            <input variable="qty"/>
            <output expression="&quot;enter unit price:&quot;" newline="True"/>
            <input variable="price"/>
            <call expression="calcbill(qty, price)"/>
            <output expression="&quot;total:&quot; &amp;total" newline="True"/>
            <output expression="&quot;tax:&quot; &amp;tax" newline="True"/>
        </body>
    </function>
    <function name="calcbill" type="None" variable="">
        <parameters>
            <parameter name="qty" type="Real" array="False"/>
            <parameter name="price" type="Real" array="False"/>
        </parameters>
        <body>
            <assign variable="total" expression="qty * price"/>
            <assign variable="tax" expression="total * 0.07"/>
        </body>
    </function>
</flowgorithm>
