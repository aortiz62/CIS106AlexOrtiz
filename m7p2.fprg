<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="m7p2"/>
        <attribute name="authors" value="mekam"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-03 01:36:53 AM"/>
        <attribute name="created" value="bWVrYW07R1JFRU5URUE7MjAyNi0xMC0wMzswMToyOTo0NSBBTTsyMzc0"/>
        <attribute name="edited" value="bWVrYW07R1JFRU5URUE7MjAyNi0xMC0wMzswMTozNjo1MyBBTTsxOzI0Nzk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="startval" type="Integer" array="False" size=""/>
            <declare name="stopval" type="Integer" array="False" size=""/>
            <declare name="incrementval" type="Integer" array="False" size=""/>
            <declare name="currentval" type="Integer" array="False" size=""/>
            <output expression="&quot;enter your start value&quot;" newline="True"/>
            <input variable="startval"/>
            <output expression="&quot;enter your stop value&quot;" newline="True"/>
            <input variable="stopval"/>
            <output expression="&quot;enter your increment value&quot;" newline="True"/>
            <input variable="incrementval"/>
            <assign variable="currentval" expression="startval"/>
            <while expression="currentval &lt;= stopval">
                <output expression="currentval" newline="True"/>
                <assign variable="currentval" expression="currentval + incrementval"/>
            </while>
        </body>
    </function>
</flowgorithm>
