<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="m8p2"/>
        <attribute name="authors" value="mekam"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-10 03:21:02 PM"/>
        <attribute name="created" value="bWVrYW07R1JFRU5URUE7MjAyNi0xMC0xMDswMzoxMDo0MSBQTTsyMzc1"/>
        <attribute name="edited" value="bWVrYW07R1JFRU5URUE7MjAyNi0xMC0xMDswMzoyMTowMiBQTTsxOzI0ODI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1" type="Integer" array="False" size=""/>
            <declare name="num2" type="Integer" array="False" size=""/>
            <declare name="nextnum" type="Integer" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="num1" expression="1"/>
            <assign variable="num2" expression="1"/>
            <output expression="num1" newline="True"/>
            <output expression="num2" newline="True"/>
            <for variable="i" start="3" end="20" direction="inc" step="1">
                <assign variable="nextnum" expression="num1 + num2"/>
                <output expression="nextnum" newline="True"/>
                <assign variable="num1" expression="num2"/>
                <assign variable="num2" expression="nextnum"/>
            </for>
        </body>
    </function>
</flowgorithm>
