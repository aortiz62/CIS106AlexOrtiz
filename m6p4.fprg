<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="m6p4"/>
        <attribute name="authors" value="mekam"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-26 02:50:17 AM"/>
        <attribute name="created" value="bWVrYW07R1JFRU5URUE7MjAyNi0wOS0yNjswMjo0NDowNyBBTTsyMzgz"/>
        <attribute name="edited" value="bWVrYW07R1JFRU5URUE7MjAyNi0wOS0yNjswMjo1MDoxNyBBTTsxOzI0ODk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="tickets" type="Integer" array="False" size=""/>
            <declare name="price" type="Real" array="False" size=""/>
            <declare name="total" type="Real" array="False" size=""/>
            <output expression="&quot;enter amount of tickets&quot;" newline="True"/>
            <input variable="tickets"/>
            <if expression="tickets &gt;= 25">
                <then>
                    <assign variable="price" expression="50"/>
                </then>
                <else>
                    <if expression="tickets &gt;= 10">
                        <then>
                            <assign variable="price" expression="60"/>
                        </then>
                        <else>
                            <if expression="tickets &gt;= 5">
                                <then>
                                    <assign variable="price" expression="70"/>
                                </then>
                                <else>
                                    <assign variable="price" expression="75"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="total" expression="tickets * price"/>
            <output expression="&quot;number of tickets:&quot; &amp;tickets" newline="True"/>
            <output expression="&quot;price of each ticket:&quot; &amp;price" newline="True"/>
            <output expression="&quot;total cost:&quot; &amp;total" newline="True"/>
        </body>
    </function>
</flowgorithm>
